<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<CheckEolWorkloads>false</CheckEolWorkloads>

    <TargetFrameworks>net9.0-android;net9.0-ios;net9.0-maccatalyst;net9.0-windows10.0.19041.0;net10.0-android;net10.0-ios;net10.0-maccatalyst;net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(CI)' == 'true'">net9.0-android35.0;net9.0-ios18.0;net9.0-maccatalyst18.0;net9.0-windows10.0.19041.0;net10.0-android36.0;net10.0-ios;net10.0-maccatalyst;net10.0-windows10.0.19041.0</TargetFrameworks>

    <RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>

		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<PackageId>CommonControls.Maui</PackageId>
		<Version>1.1.4</Version>
		<Authors>Ilija Rushkovski</Authors>
		<Description>Reusable, customizable .NET MAUI controls for everyday UI needs: borderless text inputs, password visibility toggles, inline validation feedback, animated buttons with loading states, gradients and flexible icon layouts, and bullet graphs for compact KPI displays. Integrates with XAML, data bindings and commands across Android, iOS, Mac Catalyst and Windows.</Description>
		<PackageTags>maui;entry;editor;password;handler;android;ios;maccatalyst;windows;borderless;controls;validation;border;textfield;statebutton;button;animation;gradient;divider</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/ilija2407/maui-common-controls</RepositoryUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup Condition="$(TargetFramework.StartsWith('net9'))">
		<PackageReference Include="Microsoft.Maui.Controls" Version="9.0.111" />
	</ItemGroup>

	<ItemGroup Condition="$(TargetFramework.StartsWith('net10'))">
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Assets\cc_eye.png" />
		<EmbeddedResource Include="Assets\cc_hidden.png" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="/" />
	</ItemGroup>

</Project>
