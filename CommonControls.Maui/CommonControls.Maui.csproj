<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<CheckEolWorkloads>false</CheckEolWorkloads>

		<TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>

		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>

		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<PackageId>CommonControls.Maui</PackageId>
		<Version>1.1.0</Version>
		<Authors>Ilija Rushkovski</Authors>
		<Description>Clean, customisable .NET MAUI controls — BorderlessEntry, BorderlessEditor, PasswordEntry with show/hide toggle, ValidationEntry with configurable border/separator/inline errors, and StateButton with press animations (Scale/Fade), busy/loading state, divider layout, gradient background, image positions, FontAttributes/FontSize, and IsEnabled visual feedback. Android and iOS supported.</Description>
		<PackageTags>maui;entry;editor;password;handler;android;ios;borderless;controls;validation;border;textfield;statebutton;button;animation;gradient;divider</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/ilija2407/maui-common-controls</RepositoryUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="9.0.111" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\Images\cc_eye.png" />
		<EmbeddedResource Include="Resources\Images\cc_hidden.png" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="/" />
	</ItemGroup>

</Project>
