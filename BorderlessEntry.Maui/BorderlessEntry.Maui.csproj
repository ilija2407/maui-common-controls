<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<CheckEolWorkloads>false</CheckEolWorkloads>

		<TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>

		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<PackageId>BorderlessEntry.Maui</PackageId>
		<Version>1.0.1</Version>
		<Authors>Ilija Rushkovski</Authors>
		<Description>Borderless Entry control for .NET MAUI with Android/iOS handler mappings.</Description>
		<PackageTags>maui;entry;handler;android;ios;borderless</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/ilijarushkovski/BorderlessEntry.Maui</RepositoryUrl>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="9.0.111" />
	</ItemGroup>

</Project>
