<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CommonControlsSample.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:customControls="clr-namespace:CommonControls.Maui.Controls;assembly=CommonControls.Maui">

    <ScrollView>
        <VerticalStackLayout Padding="30,0" Spacing="25">
            <Image
                Aspect="AspectFit"
                HeightRequest="185"
                SemanticProperties.Description="dot net bot in a race car number eight"
                Source="dotnet_bot.png" />

            <Label
                FontSize="32"
                HorizontalOptions="Center"
                SemanticProperties.HeadingLevel="Level1"
                Text="Hello, World!" />

            <Label
                FontSize="18"
                HorizontalOptions="Center"
                SemanticProperties.Description="Welcome to dot net Multi platform App U I"
                SemanticProperties.HeadingLevel="Level2"
                Text="Welcome to .NET Multi-platform App UI" />

            <Label
                FontAttributes="Bold"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Text="Common Controls - BorderlessEntry &amp; BorderlessEditor" />

            <customControls:BorderlessEntry Placeholder="Checkout my borderless entry" />

            <Entry Placeholder="This is regular entry" />

            <customControls:BorderlessEditor HeightRequest="40" Placeholder="Checkout my borderless editor" />

            <Editor HeightRequest="40" Placeholder="This is regular editor" />

            <Label
                FontAttributes="Bold"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Text="PasswordEntry with show/hide toggle" />

            <Entry IsPassword="True" Placeholder="This is regular entry with IsPassword" />

            <customControls:PasswordEntry Placeholder="Enter your password" />

            <customControls:PasswordEntry
                HidePasswordImageSource="custom_hide.png"
                ImageHeight="25"
                ImageWidth="25"
                Placeholder="Custom icons password"
                ShowPasswordImageSource="custom_show.png" />

            <Label
                FontAttributes="Bold"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Text="ValidationEntry" />

            <customControls:ValidationEntry Keyboard="Numeric" Placeholder="No border (default)" />

            <customControls:ValidationEntry
                x:Name="EmailEntryNoSeparator"
                BorderColor="Gray"
                ErrorMessage="Please enter a valid email"
                ErrorSeparatorColor="Red"
                IsValid="False"
                Placeholder="Email - no border, separator only"
                SeparatorVisible="False" />

            <customControls:ValidationEntry
                x:Name="EmailEntry"
                ErrorMessage="Please enter a valid email"
                ErrorSeparatorColor="Red"
                IsValid="False"
                Placeholder="Email - no border, separator only"
                SeparatorVisible="True" />

            <customControls:ValidationEntry
                BorderColor="Gray"
                BorderVisible="True"
                ErrorBorderColor="Gray"
                ErrorMessage="This field is required"
                ErrorSeparatorColor="Red"
                IsValid="False"
                Placeholder="Email - border and separator"
                SeparatorVisible="True" />

            <customControls:ValidationEntry
                x:Name="PasswordValidationEntry"
                Margin="0,0,0,40"
                BorderColor="Black"
                BorderVisible="True"
                CornerRadius="8"
                ErrorBorderColor="Red"
                ErrorColor="Orange"
                ErrorFontSize="11"
                ErrorMessage="Must be at least 8 characters"
                ErrorSeparatorColor="Black"
                IsValid="False"
                Placeholder="Password"
                SeparatorVisible="True"
                Text="abc" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
